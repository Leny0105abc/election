# Copy to `.env` ON THE SERVER ONLY. Never commit the real file.
APP_NAME=SchoolVote
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://election.nancapiannhs.com
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=HOSTINGER_DATABASE_NAME
DB_USERNAME=HOSTINGER_DATABASE_USER
DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=schoolvote
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=HOSTINGER_MAILBOX
MAIL_PASSWORD=HOSTINGER_MAILBOX_PASSWORD
MAIL_FROM_ADDRESS="noreply@nancapiannhs.com"
MAIL_FROM_NAME="SchoolVote"

SCHOOLVOTE_PIN_LENGTH=6
SCHOOLVOTE_PIN_ROUNDS=10
SCHOOLVOTE_REQUIRE_STAFF_2FA=true
SCHOOLVOTE_STUDENT_IDLE_MINUTES=10
