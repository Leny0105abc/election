APP_NAME=SchoolVote
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://schoolvote.test
# Display timezone for dates shown to people. Database timestamps are always stored in UTC.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Create this database and user yourself (see README "Local setup").
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolvote
DB_USERNAME=schoolvote_local
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=schoolvote

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@schoolvote.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- SchoolVote ---
# Numeric PIN length for students.
SCHOOLVOTE_PIN_LENGTH=6
# bcrypt cost for PIN hashes (10 keeps bulk PIN generation fast on shared hosting).
SCHOOLVOTE_PIN_ROUNDS=10
# Require staff to enable two-factor authentication (recommended: true in production).
SCHOOLVOTE_REQUIRE_STAFF_2FA=false
# Minutes of inactivity before a student is signed out.
SCHOOLVOTE_STUDENT_IDLE_MINUTES=10
